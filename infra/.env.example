# 로컬 개발용 자격증명·시크릿. 실제 값은 `infra/.env` 로 복사 후 사용.
#   cp infra/.env.example infra/.env
#
# .env 는 .gitignore 대상 — 운영 자격증명은 절대 commit 하지 않는다.
# AWS 매핑 시 이 파일에 들어 있는 값들은 IAM Role / Secrets Manager / SSM 으로 대체.

# ─── Object storage (MinIO ↔ S3) ────────────────────────────
# MinIO root 와 Iceberg/Spark/Trino 의 S3 클라이언트가 같은 키를 공유.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_REGION=us-east-1

# ─── Airflow standalone ────────────────────────────────────
# `airflow standalone` 의 초기 admin 계정. 로그인 후 변경 권장.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ─── Superset ──────────────────────────────────────────────
# SUPERSET_SECRET_KEY 는 세션·CSRF 토큰 서명에 사용. 운영은 반드시 교체.
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=phm-local-dev-secret-change-me
